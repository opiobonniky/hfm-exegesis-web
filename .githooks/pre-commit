#!/bin/sh
#
# Exegesis (web) pre-commit hook
# Runs TypeScript typecheck on staged .ts/.tsx files to catch JSX nesting
# issues and type errors before they reach the dev server.
#
# Setup: npm run setup:hooks
# Bypass: git commit --no-verify

echo "🔍 Full-project TypeScript typecheck (triggered by staged files)..."

PROJECT_ROOT="$(git rev-parse --show-toplevel)"

# Check if we have any staged .ts/.tsx files
STAGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx)$' || true)

if [ -z "$STAGED_TS_FILES" ]; then
  echo "✅ No TypeScript files staged — skipping typecheck"
  exit 0
fi

echo "  Found $(echo "$STAGED_TS_FILES" | wc -l | xargs) staged .ts/.tsx file(s)"

# Run full-project typecheck using tsconfig.app.json (app source only).
# We check the entire project (not just staged files) because types may
# depend on unstaged but already-committed code.
cd "$PROJECT_ROOT" && npx tsc --noEmit --project tsconfig.app.json --pretty 2>&1

EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
  echo ""
  echo "❌ TypeScript typecheck FAILED. Fix the errors above before committing."
  echo "   To bypass this check: git commit --no-verify"
  exit 1
else
  echo "✅ TypeScript typecheck passed — all clean"
  exit 0
fi
